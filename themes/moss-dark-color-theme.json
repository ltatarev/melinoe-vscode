  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8fb299",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment keyword",
        "comment storage.type",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#c3b2e4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment variables",
      "scope": [
        "comment variable",
        "comment entity.name.type"
      ],
      "settings": {
        "foreground": "#7fd3c0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#e1eadb"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter variable"
      ],
      "settings": {
        "foreground": "#eaaa7f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "entity.name.field"
      ],
      "settings": {
        "foreground": "#cfdfc6"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.parameter.function.language.special.self"
      ],
      "settings": {
        "foreground": "#c3b2e4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#8fd19c"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#a9c2ae"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#a9c2ae"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#e6c97a"
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#8fd19c"
      }
    },
    {
      "name": "Escapes and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#eca4ae"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.character"
      ],
      "settings": {
        "foreground": "#eaaa7f"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "meta.require",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#8fc8e0"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.namespace",
        "storage.type.primitive",
        "storage.type.built-in",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#7fd3c0"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "entity.name.function.decorator",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#c3b2e4"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8fd19c"
      }
    },
    {
      "name": "Tag brackets",
      "scope": [
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#a9c2ae"
      }
    },
    {
      "name": "Components",
      "scope": [
        "support.class.component",
        "entity.name.tag.tsx",
        "entity.name.tag.jsx"
      ],
      "settings": {
        "foreground": "#7fd3c0"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#eaaa7f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#8fc8e0"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#cfdfc6"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value",
        "support.constant.color",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#eaaa7f"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#8fc8e0"
      }
    },
    {
      "name": "YAML and TOML keys",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.toml",
        "keyword.key.toml"
      ],
      "settings": {
        "foreground": "#8fc8e0"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#8fd19c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#eaaa7f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#c3b2e4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#8fb299",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#e6c97a"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#8fc8e0"
      }
    },
    {
      "name": "Markdown lists and quotes",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.quote",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#eca4ae"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#76bd84"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#f08f85"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#8fc8e0"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f08f85"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#e6c97a",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#e1eadb",
    "variable.readonly": "#eaaa7f",
    "variable.defaultLibrary": "#7fd3c0",
    "parameter": {
      "foreground": "#eaaa7f",
      "italic": true
    },
    "property": "#cfdfc6",
    "property.readonly": "#cfdfc6",
    "function": "#8fc8e0",
    "method": "#8fc8e0",
    "class": "#7fd3c0",
    "interface": "#7fd3c0",
    "enum": "#7fd3c0",
    "enumMember": "#eaaa7f",
    "type": "#7fd3c0",
    "typeParameter": {
      "foreground": "#7fd3c0",
      "italic": true
    },
    "namespace": "#7fd3c0",
    "decorator": "#c3b2e4",
    "macro": "#c3b2e4",
    "selfKeyword": {
      "foreground": "#c3b2e4",
      "italic": true
    },
    "keyword": "#8fd19c",
    "string": "#e6c97a",
    "number": "#eaaa7f",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
